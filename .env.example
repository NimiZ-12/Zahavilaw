# ---------------------------------------------------------------------------
# Zahavi Law — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Public base URL of the site (used for canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://www.zahavilaw.com

# Set to "true" on preview/staging deployments to keep the site OUT of Google
# (no indexing). Leave unset/empty on the real production site.
SITE_NOINDEX=

# Google Analytics 4 measurement id (looks like "G-XXXXXXXXXX"). When set,
# gtag.js loads on every page. Analytics is automatically disabled whenever
# SITE_NOINDEX=true, so the preview deployment never records traffic.
NEXT_PUBLIC_GA_ID=

# --- Cloudflare Turnstile (CAPTCHA on the contact form) --------------------
# Create a widget at https://dash.cloudflare.com → Turnstile. Use the "managed"
# challenge type. The site key is public (sent to the browser); the secret key
# must stay server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Lead email notifications (Resend) -------------------------------------
# API key from https://resend.com (verify the zahavilaw.com domain there
# first). The sender must be on the verified domain. Recipients default to
# the office addresses; override with a comma-separated LEAD_EMAIL_TO.
RESEND_API_KEY=
LEAD_EMAIL_FROM="Zahavi Law Website <leads@zahavilaw.com>"
LEAD_EMAIL_TO=

# --- Monday.com CRM integration --------------------------------------------
# API token: monday.com → avatar → Developers → My Access Tokens
MONDAY_API_TOKEN=

# Numeric id of the leads board (open the board; it's in the URL).
MONDAY_BOARD_ID=

# Optional: the group within the board to create new leads in (e.g. "topics").
MONDAY_GROUP_ID=

# Optional: map our lead fields to your board's column ids (JSON).
# Find column ids via the Monday API or the column settings menu.
# Example:
# MONDAY_COLUMN_MAP={"email":"email","phone":"phone","subject":"text","message":"long_text","preferredTime":"text0","locale":"text1","source":"text2"}
MONDAY_COLUMN_MAP=
